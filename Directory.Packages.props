<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft's out-of-band ConPTY: conpty.dll plus OpenConsole.exe, newer
         than the copy built into Windows. -->
    <PackageVersion Include="Microsoft.Windows.Console.ConPTY" Version="1.25.260930003" />

    <!-- A port of xterm.js's core, so a captured pane matches what the
         browser's xterm.js renders. -->
    <PackageVersion Include="XtermSharp" Version="1.0.0-alpha.10" />

    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="TUnit" Version="1.76.0" />
  </ItemGroup>

</Project>
